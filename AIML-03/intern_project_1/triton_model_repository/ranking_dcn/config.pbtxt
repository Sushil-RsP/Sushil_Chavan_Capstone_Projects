name: "ranking_dcn"
platform: "onnxruntime_onnx"
max_batch_size: 256

input [
  {
    name: "user_id"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "item_id"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "dense_features"
    data_type: TYPE_FP32
    dims: [ 24 ]
  }
]

output [
  {
    name: "ctr_score"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 5000
}

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
